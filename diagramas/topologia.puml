@startuml topologia_biblioteca_central
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 50
skinparam packageStyle rectangle

title Topología Física en Estrella - Biblioteca Central "León Pinelo"

package "Cuarto de Telecomunicaciones (MDF)" {
    node "Rack 24U" {
        [Router / Firewall ISP] as ROUTER
        [Switch 48P Gigabit PoE+] as SWITCH
        [Servidor Catálogo OPAC] as OPAC_SRV
        [Servidor NAS Respaldo] as NAS
        [NVR Cámaras IP] as NVR
        
        ROUTER --> SWITCH
        OPAC_SRV --> SWITCH
        NAS --> SWITCH
        NVR --> SWITCH
    }
}

package "Sala de Cómputo Estudiantil" {
    [16x Computadoras para Estudiantes] as PC_EST
    [AP-02 Wi-Fi 6 Techo] as AP2
}

package "Módulos de Consulta (Pasillos)" {
    [4x Terminales Táctiles OPAC] as MOD_OPAC
}

package "Cubículos de Estudio Grupal (3)" {
    [6x Puntos de Red en Mesas] as PUNTOS_CUB
    [3x Smart TVs Interactivas] as TV_CUB
    [AP-03 Wi-Fi 6] as AP3
}

package "Sala de Lectura Silenciosa" {
    [AP-01 Wi-Fi 6 Techo] as AP1
}

package "Recepción, Préstamo y Circulación" {
    [3x Computadoras Bibliotecarios] as PC_BIB
    [1x Impresora Multifuncional LAN] as IMP_BIB
    [AP-04 Wi-Fi 6] as AP4
}

package "Dirección y Catalogación Técnica" {
    [2x Computadoras Gestión] as PC_DIR
}

package "Seguridad Perimétrica" {
    [4x Cámaras IP PoE] as CAMS
}

SWITCH -- PC_EST : UTP Cat 6 (1 Gbps)
SWITCH .. AP2 : UTP Cat 6 (PoE)

SWITCH -- MOD_OPAC : UTP Cat 6
SWITCH -- PUNTOS_CUB : UTP Cat 6
SWITCH -- TV_CUB : UTP Cat 6
SWITCH .. AP3 : UTP Cat 6 (PoE)

SWITCH .. AP1 : UTP Cat 6 (PoE)

SWITCH -- PC_BIB : UTP Cat 6
SWITCH -- IMP_BIB : UTP Cat 6
SWITCH .. AP4 : UTP Cat 6 (PoE)

SWITCH -- PC_DIR : UTP Cat 6
SWITCH .. CAMS : UTP Cat 6 (PoE)

@enduml
